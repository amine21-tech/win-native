# Copier en .env puis adapter. Aucune valeur ci-dessous n'est utilisable telle
# quelle en production.

NODE_ENV=development
PORT=3002
HOST=0.0.0.0

# En conteneur, docker-compose.yml remplace DATABASE_URL et REDIS_URL par les
# noms de services. Ces valeurs ne servent qu'au developpement local.
DATABASE_URL=postgres://win:win@127.0.0.1:5432/win
REDIS_URL=redis://127.0.0.1:6379

# Generer avec :  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=remplacer-par-une-valeur-aleatoire-de-48-octets-minimum

# En production derriere Nginx, l'API est servie sous le prefixe /v2 :
#   PUBLIC_BASE_URL=https://51.77.194.25.nip.io/v2
PUBLIC_BASE_URL=http://localhost:3002
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_BYTES=8388608

VALHALLA_URL=http://127.0.0.1:8002

# Ancien backend du site (win-backend). La recherche de lieux l'interroge en plus de cette base,
# pour que les adresses et les photos ajoutees DEPUIS LE SITE apparaissent aussi dans
# l'application. Laisser vide pour desactiver la passerelle. Sur le VPS, une adresse interne
# (sans passer par Nginx ni TLS) repond plus vite que l'adresse publique.
# LEGACY_API_URL=https://51.77.194.25.nip.io/api

CORS_ORIGINS=*
LOG_LEVEL=info
