{
  "name": "@win/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "tsx src/db/migrate.ts",
    "db:push:prod": "node dist/src/db/migrate.js",
    "migrate:legacy": "tsx scripts/migrate-legacy.ts",
    "migrate:legacy:prod": "node dist/scripts/migrate-legacy.js",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:admin:prod": "node dist/scripts/seed-admin.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.0.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@win/shared": "*",
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.38.2",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.2",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  }
}
