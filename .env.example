# Variables lues par docker compose (mot de passe de la base).
# Copier en .env a la racine du depot, sur le VPS :
#   cp .env.example .env && nano .env
#
# Generer un mot de passe :
#   openssl rand -base64 32

POSTGRES_USER=win
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-aleatoire
POSTGRES_DB=win
